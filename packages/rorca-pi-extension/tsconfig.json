{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["extensions/**/*.ts", "extensions/**/*.d.ts", "vscode-extension/src/**/*.ts", "vscode-extension/src/**/*.d.ts", "../../backend/src/types/express.d.ts"]
}
