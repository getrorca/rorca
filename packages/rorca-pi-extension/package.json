{
  "name": "@rorca/pi-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "keywords": ["pi-package", "rorca", "pi-extension", "vscode-extension"],
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:vscode": "tsc -p vscode-extension/tsconfig.json --noEmit",
    "setup:vscode-hosts": "node vscode-extension/out/packages/rorca-pi-extension/vscode-extension/src/install.js"
  }
}
