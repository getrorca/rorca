# Copy to an untracked file and use only with docker-compose.campaign-staging.yml.
# This overlay is isolated from the ordinary Rorca Compose project and production.
# Use independent URL-safe random values; bootstrap is never injected into Rorca.
CAMPAIGN_STAGING_POSTGRES_BOOTSTRAP_PASSWORD=replace-with-random-staging-bootstrap-password
CAMPAIGN_STAGING_MIGRATION_DATABASE_PASSWORD=replace-with-random-staging-migrator-password
CAMPAIGN_STAGING_RUNTIME_DATABASE_PASSWORD=replace-with-random-staging-runtime-password
CAMPAIGN_STAGING_CANONICAL_WRITER_DATABASE_PASSWORD=replace-with-random-staging-writer-password
CAMPAIGN_STAGING_JWT_SECRET=replace-with-at-least-32-random-bytes
CAMPAIGN_STAGING_INTERNAL_SERVICE_TOKEN=replace-with-at-least-32-random-bytes
CAMPAIGN_STAGING_DISPATCH_RECEIVER_TOKEN=replace-with-a-distinct-at-least-32-random-bytes
