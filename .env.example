# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Execution engine ──────────────────────────────────────────────────────────
# Options: claude (default, uses Claude subscription), opencode, codex, pi
RORCA_AGENT=claude

# Model for opencode path (e.g. openai/gpt-4o, anthropic/claude-sonnet-4-6)
# Ignored when RORCA_AGENT=claude, codex, or pi
RORCA_MODEL=

# Optional explicit binary paths when PATH discovery is not enough
OPENCODE_BIN=
CODEX_BIN=
PI_BIN=
CLAUDE_BIN=

# Mandatory for every model/tool/workspace-code subprocess. There is no raw
# local-development bypass; use an HTTP SDK provider or the Linux image when
# the host cannot provide this boundary.
RORCA_AUTONOMOUS_ISOLATION=linux-bwrap
RORCA_BWRAP_BIN=/usr/bin/bwrap
RORCA_AUTONOMOUS_MODEL_EGRESS_HOSTS=api.anthropic.com,api.openai.com,openrouter.ai,generativelanguage.googleapis.com

# Temporary wave-parallel experiment. Sequential execution is the safe default.
# Exact "true" enables explicit parallel requests only outside NODE_ENV=production.
# Production always ignores/refuses this opt-in; do not enable it in deployed environments.
RORCA_EXPERIMENTAL_WAVE_PARALLEL=false

# ── API keys (set the one matching your runtime/provider) ────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
GOOGLE_API_KEY=
GITHUB_TOKEN=
GH_TOKEN=

# ── Spec generation provider ─────────────────────────────────────────────────
# Options: claude (default), anthropic, openrouter
SPEC_PROVIDER=claude

# ── Graph scoring rollout ────────────────────────────────────────────────────
RORCA_GRAPH_SCORING_ENABLED=false
RORCA_GRAPH_SCORING_WEIGHT=

# ── Hilo codegraph provider (Context Intelligence Platform) ──────────────────
# Hilo hydrates a workspace's code structure into rebuildable graph metadata.
# Graph-only: no FUSE mount, extended attributes, file watchers, or remote backend.
# Per-workspace config lives in <workspace>/.rorca/config.json under a "hilo" key;
# these env vars override it for operator/CI control. Leave unset to keep Hilo off.
RORCA_HILO_ENABLED=false
# Path or bare command name of the pinned Hilo binary (mirrors CODEX_BIN/CLAUDE_BIN).
HILO_BIN=
# Checkout Hilo runs against (defaults to the workspace root).
RORCA_HILO_CHECKOUT=
# Output dir for Hilo's rebuildable graph (default: .rorca/hilo).
RORCA_HILO_OUTPUT_DIR=
# Per-run hydration timeout in ms (default 120000; clamped to 1000–1800000).
RORCA_HILO_TIMEOUT_MS=

# ── Local/server auth ────────────────────────────────────────────────────────
# OSS Rorca is local-first. Leave AUTH_REQUIRED=false for the default single-user mode.
AUTH_REQUIRED=false
JWT_SECRET=change-me-for-non-local-deployments
# Shared only by trusted server/worker processes. Generate at least 32 random
# bytes (for example: openssl rand -base64 48); never expose it to agents.
# If Hermes is deployed, its RORCA_API_TOKEN must equal this exact value; its
# RORCA_MCP_TOKEN remains a distinct MCP-only credential.
RORCA_INTERNAL_SERVICE_TOKEN=
# Configure only the SHA-256 digest. Enter the preimage explicitly in GitHub
# Settings when provider changes are needed; it is retained in browser memory only.
RORCA_OPERATOR_CAPABILITY_SHA256=

# ── App URLs ─────────────────────────────────────────────────────────────────
RORCA_BASE_URL=http://localhost:5210
CORS_ORIGIN=http://localhost:5210

# ── Optional email / notifications ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM='Rorca <no-reply@example.com>'
RESEND_API_KEY=
RORCA_EMAIL_FROM='Rorca <no-reply@example.com>'
