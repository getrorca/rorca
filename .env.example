# Rorca — Environment Variables
# Copy to .env and fill in values

# ─── Core ────────────────────────────────────────────────────────────────────
DB_PATH=./rorca.db
PORT=3030
RORCA_API_URL=http://localhost:3030

# ─── LLM Providers (legacy — current default uses claude CLI) ────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
OPENROUTER_API_KEY=sk-or-v1-xxx
SPEC_PROVIDER=anthropic
SPEC_MODEL_ANTHROPIC=claude-sonnet-4-6
SPEC_MODEL_OPENROUTER=openai/gpt-oss-120b

# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# VITE_API_URL=http://localhost:3030

# ─── Docker Compose ────────────────────────────────────────────────────────
# Port to expose the Rorca UI (default: 5210)
RORCA_PORT=5210
# CORS origin for backend (should match frontend URL in Docker)
CORS_ORIGIN=http://localhost:5210
# JWT secret for authentication (change in production!)
JWT_SECRET=change-me-in-production
