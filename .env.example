# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Execution engine ──────────────────────────────────────────────────────────
# Options: claude (default, uses Claude subscription), opencode, codex
RORCA_AGENT=claude

# Model for opencode path (e.g. openai/gpt-4o, anthropic/claude-sonnet-4-6)
# Ignored when RORCA_AGENT=claude or codex
RORCA_MODEL=

# ── API keys (set the one matching your RORCA_AGENT / SPEC_PROVIDER) ─────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
GOOGLE_API_KEY=...

# ── Spec generation provider ──────────────────────────────────────────────────
# Options: claude (default), anthropic, openrouter
SPEC_PROVIDER=claude

# ── Security ──────────────────────────────────────────────────────────────────
# Legacy JWT secret removed — replaced by Supabase auth.
# Optional: set `VAULT_KEY` in `backend/.env` if you want an explicit backend-only
# encryption key for stored integration tokens instead of the fallback dev secret.

# ── Supabase (frontend / Vite) ────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional server-side fallback for verifying Supabase JWTs outside Supabase APIs.
# Do not prefix with VITE_; this must stay backend-only.
SUPABASE_JWT_SECRET=
