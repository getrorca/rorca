# Copy this file to .env and fill in your values
# cp .env.example .env
#
# Everything below is optional except the database section: Rorca needs a
# PostgreSQL 16 database to start. Pick ONE of the three modes.

# ── Database (required) ──────────────────────────────────────────────────────
# RORCA_DB_MODE: native | docker | byop
#   native  — a PostgreSQL you run yourself (default port 5433)
#   docker  — the bundled container, started with `rorca db start` (port 5432)
#   byop    — bring your own Postgres (Supabase, Neon, Railway, RDS…)
# In byop mode DATABASE_URL is authoritative and must point at the provider.
RORCA_DB_MODE=native
RORCA_PG_PORT=5433
# Only used by docker mode; change it when 5432 is already taken.
RORCA_DOCKER_PORT=5432

# Connection string. For native/docker this may be omitted (Rorca derives it);
# for byop and for any non-default host/user it is required.
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Split-principal settings. Rorca runs migrations and runtime traffic as
# separate, least-privilege roles. Fresh installs get these provisioned by
#   npm run bootstrap:byop -- --url "$DATABASE_URL"
# which writes 0600 profile files under ~/.rorca. Leave blank to derive them
# from DATABASE_URL with the default role names.
RORCA_RUNTIME_DATABASE_USER=
RORCA_RUNTIME_DATABASE_URL=
RORCA_MIGRATION_DATABASE_URL=
RORCA_CANONICAL_WRITER_DATABASE_USER=
RORCA_CANONICAL_WRITER_DATABASE_URL=

# ── Execution engine ──────────────────────────────────────────────────────────
# Options: omp (qualified default), pi, claude, opencode, codex
RORCA_AGENT=claude

# Model for opencode path (e.g. openai/gpt-4o, anthropic/claude-sonnet-4-6)
# Ignored when RORCA_AGENT=claude, codex, or pi
RORCA_MODEL=

# Optional explicit binary paths when PATH discovery is not enough
OPENCODE_BIN=
CODEX_BIN=
PI_BIN=
OMP_BIN=
# Enable only after MIG-001 sandbox qualification passes for this deployment.
RORCA_OMP_SANDBOX_QUALIFIED=false
CLAUDE_BIN=

# Mandatory for every model/tool/workspace-code subprocess. There is no raw
# local-development bypass; use an HTTP SDK provider or the Linux image when
# the host cannot provide this boundary.
RORCA_AUTONOMOUS_ISOLATION=linux-bwrap
RORCA_BWRAP_BIN=/usr/bin/bwrap
RORCA_AUTONOMOUS_MODEL_EGRESS_HOSTS=api.anthropic.com,api.openai.com,openrouter.ai,generativelanguage.googleapis.com

# Pre-staging checks never execute in the API process. Workers require a
# private immutable toolchain descriptor and one pinned networkless sandbox.
# `RORCA_QUALIFICATION_TOOLCHAIN_DIGEST` hashes the exact bytes of
# <root>/rorca-qualification-toolchain.json. Missing/mismatched values block.
RORCA_QUALIFICATION_TOOLCHAIN_ROOT=
RORCA_QUALIFICATION_TOOLCHAIN_DIGEST=
# Linux: absolute bubblewrap binary plus its exact file digest.
RORCA_QUALIFICATION_BWRAP_BIN=
RORCA_QUALIFICATION_BWRAP_DIGEST=
# macOS: absolute Docker CLI plus a locally inspected immutable image ID/digest.
RORCA_QUALIFICATION_DOCKER_BIN=
RORCA_QUALIFICATION_DOCKER_IMAGE=

# Temporary wave-parallel experiment. Sequential execution is the safe default.
# Exact "true" enables explicit parallel requests only outside NODE_ENV=production.
# Production always ignores/refuses this opt-in; do not enable it in deployed environments.
RORCA_EXPERIMENTAL_WAVE_PARALLEL=false

# ── Operator-owned bounty feature boundary ──────────────────────────────────
# Leave unset/empty to use persisted admin policy; if no policy exists, bounty
# target effects are disabled. This strict deployment policy is the only
# non-API enable authority; unknown/missing fields fail startup resolution.
# Never place this policy in workspace `.rorca/config.json`, specs, or manifests.
# Example: {"state":"enabled","missionMode":"bounty","revision":1,"auditIdentity":"deployment:change-123"}
RORCA_BOUNTY_DEPLOYMENT_POLICY=
# Comma-separated `sha256:` SPKI fingerprints for the first external canary.
# Empty values authorize nobody; legal, security, and operator roots are distinct.
RORCA_BOUNTY_CANARY_LEGAL_KEY_HASHES=
RORCA_BOUNTY_CANARY_SECURITY_KEY_HASHES=
RORCA_BOUNTY_CANARY_OPERATOR_KEY_HASHES=

# ── API keys (set the one matching your runtime/provider) ────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
GOOGLE_API_KEY=
GITHUB_TOKEN=
GH_TOKEN=

# ── Spec generation provider ─────────────────────────────────────────────────
# Options: claude (default), anthropic, openrouter
SPEC_PROVIDER=claude

# ── Graph scoring rollout ────────────────────────────────────────────────────
RORCA_GRAPH_SCORING_ENABLED=false
RORCA_GRAPH_SCORING_WEIGHT=

# ── Hilo codegraph provider (Context Intelligence Platform) ──────────────────
# Hilo hydrates a workspace's code structure into rebuildable graph metadata.
# Graph-only: no FUSE mount, extended attributes, file watchers, or remote backend.
# Per-workspace config lives in <workspace>/.rorca/config.json under a "hilo" key;
# these env vars override it for operator/CI control. Leave unset to keep Hilo off.
RORCA_HILO_ENABLED=false
# Path or bare command name of the pinned Hilo binary (mirrors CODEX_BIN/CLAUDE_BIN).
HILO_BIN=
# Checkout Hilo runs against (defaults to the workspace root).
RORCA_HILO_CHECKOUT=
# Output dir for Hilo's rebuildable graph (default: .rorca/hilo).
RORCA_HILO_OUTPUT_DIR=
# Per-run hydration timeout in ms (default 120000; clamped to 1000–1800000).
RORCA_HILO_TIMEOUT_MS=

# ── Local/server auth ────────────────────────────────────────────────────────
# OSS Rorca is local-first. Leave AUTH_REQUIRED=false for the default single-user mode.
AUTH_REQUIRED=false
# Required only when AUTH_REQUIRED=true. Generate one: openssl rand -base64 48
JWT_SECRET=
# Shared only by trusted server/worker processes. Generate at least 32 random
# bytes (for example: openssl rand -base64 48); never expose it to agents.
# If Hermes is deployed, its RORCA_API_TOKEN must equal this exact value; its
# RORCA_MCP_TOKEN remains a distinct MCP-only credential.
RORCA_INTERNAL_SERVICE_TOKEN=
# Configure only the SHA-256 digest. Enter the preimage explicitly in GitHub
# Settings when provider changes are needed; it is retained in browser memory only.
RORCA_OPERATOR_CAPABILITY_SHA256=
# AES-256-GCM key for provider-neutral credential SecretStore objects. Generate
# exactly 32 random bytes as 64 hex characters and keep it outside agent/runtime prompts.
RORCA_CREDENTIAL_STORE_KEY=
# Ed25519 public-key bindings for isolated Stripe Dashboard operator evidence.
# [{"keyId":"...","publicKeyPem":"...","workspaceId":"...","accountId":"acct_...","operatorIds":["..."],"modes":["test"]}]
RORCA_STRIPE_DASHBOARD_EVIDENCE_KEYS_JSON=
# Experimental authenticated browser session broker. It is disabled by default.
# The master key must be exactly 32 random bytes in base64 (for example:
# `openssl rand -base64 32`) and must exist only in trusted server/runner env.
RORCA_BROWSER_SESSION_BROKER_ENABLED=false
# Separately enable the disposable BSB-004 Claude OAuth/MCP conformance fixture.
# It accepts only the fixed Claude test client, PKCE flow, scope, and harmless tool.
RORCA_BROWSER_MCP_CONFORMANCE_ENABLED=false
RORCA_BROWSER_PROFILE_MASTER_KEY=
# Ciphertext-only profile artifacts; keep outside every workspace/model sandbox.
RORCA_BROWSER_PROFILE_STORE_DIR=

# Signed provider-human issuer bindings. `ownerActorIds` is mandatory for an
# actor that may authorize exact historical run-closeout reconciliation; issuer
# or filesystem access alone never implies workspace ownership.
# Example shape only: [{"issuerId":"...","keyId":"...","publicKeyPem":"...","provider":"...","providerTenantId":"...","workspaceId":"...","ownerActorIds":["external-owner-id"]}]
RORCA_PROVIDER_HUMAN_ISSUERS_JSON=
# Required only for historical closeout reconciliation. API and worker must
# receive the exact same build-time/deployment receipt before process startup;
# absence leaves ordinary service behavior available but this protocol fails closed.
# JSON also binds the reviewed source baseline, exact Wave 1 spec hash, and canonical repository.
# {"schemaVersion":"rorca.build-identity-receipt.v1","buildSha":"<40 lowercase hex>","artifactDigest":"sha256:<64 lowercase hex>","deploymentId":"<immutable rollout ID>","issuedAt":"<UTC ISO timestamp>","implementationBaselineSha":"407752564e654e1bc8d83af4d9f5154f6807f307","waveSpecRevision":"sha256:caeb0720cd09f4e6a5cd22b078b2d50932b34613262c15631cdf71af9c056920","sourceRepository":"https://github.com/getrorca/rorca.git"}
RORCA_BUILD_IDENTITY_RECEIPT=

# ── App URLs ─────────────────────────────────────────────────────────────────
RORCA_BASE_URL=http://localhost:5210
CORS_ORIGIN=http://localhost:5210

# ── Server & runtime ─────────────────────────────────────────────────────────
PORT=3030
# Interface to bind. Loopback by default; Rorca is single-user and local-first.
RORCA_BIND_HOST=127.0.0.1
# Serve the built dashboard and the MCP endpoint from the same process.
RORCA_SERVE_STATIC=true
RORCA_SERVE_MCP=true
# MCP over HTTP is loopback-only unless this is explicitly true.
RORCA_MCP_ALLOW_REMOTE=false
LOG_LEVEL=info

# ── Run traces (Context Inspector) ───────────────────────────────────────────
# Raw context payloads are written as .ndjson.gz under <workspace>/.rorca/traces.
RORCA_TRACE_RETENTION_DAYS=14
RORCA_TRACE_MAX_PAYLOAD_BYTES=5242880

# ── Optional email / notifications ───────────────────────────────────────────
# The OSS edition ships no hosted email surface: account verification, password
# reset, team invites, and run-complete email belong to the hosted product.
# Operator-side notifications use the in-app notification centre and WAL stream.

# ── Full internal variable inventory ─────────────────────────────────────────
# Every remaining variable read by the codebase. These are internal: test
# hooks, failpoints, qualification harnesses, and operator diagnostics. You
# do not need to set any of them for a normal install; they are listed so the
# environment surface is fully documented in one place.
