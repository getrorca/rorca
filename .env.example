# Rorca — Environment Variables
# Copy to .env and fill in values

# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://rorca:rorca@localhost:5432/rorca
PORT=3030
RORCA_API_URL=http://localhost:3030

# ─── Execution Engine ─────────────────────────────────────────────────────────
# Choose execution path: "claude" (default, uses Claude subscription) or "opencode" (API key, 75+ models)
RORCA_AGENT=claude
# OpenCode model string (provider/model format). Only used when RORCA_AGENT=opencode.
# Examples:
#   RORCA_MODEL=openai/gpt-4o           # OpenAI
#   RORCA_MODEL=google/gemini-2.0-flash # Google
#   RORCA_MODEL=anthropic/claude-sonnet-4-5-20250929  # Anthropic API
#   RORCA_MODEL=openrouter/auto         # OpenRouter (auto-route)
#   RORCA_MODEL=ollama/llama3           # Local Ollama (free)
#   RORCA_MODEL=github/copilot          # GitHub Copilot subscription
RORCA_MODEL=openai/gpt-4o
# Custom OpenCode binary path (auto-detected from PATH if omitted)
# OPENCODE_BIN=/usr/local/bin/opencode

# ─── LLM Providers (for spec generation when not using OpenCode) ─────────────
ANTHROPIC_API_KEY=sk-ant-xxx
OPENROUTER_API_KEY=sk-or-v1-xxx
SPEC_PROVIDER=anthropic
SPEC_MODEL_ANTHROPIC=claude-sonnet-4-6
SPEC_MODEL_OPENROUTER=openai/gpt-oss-120b

# ─── Frontend (Vite) ────────────────────────────────────────────────────────
# VITE_API_URL=http://localhost:3030

# ─── Docker Compose ────────────────────────────────────────────────────────
# Port to expose the Rorca UI (default: 5210)
RORCA_PORT=5210
# CORS origin for backend (should match frontend URL in Docker)
CORS_ORIGIN=http://localhost:5210
# JWT secret for authentication (change in production!)
JWT_SECRET=change-me-in-production

# ─── Privacy & Telemetry ────────────────────────────────────────────────────────
# Telemetry: opt-in only, OFF by default (0 = off, 1 = on)
# When enabled, only anonymous metrics are sent: event type, agent type, story count, duration
# NEVER sent: spec content, code, file paths, workspace names, API keys
# See PRIVACY.md for full details
RORCA_TELEMETRY=0
