{
  "name": "rorca-vscode",
  "displayName": "Rorca — Spec-Driven Development",
  "description": "Rorca MCP tools browser and pipeline control for VS Code",
  "version": "0.1.0",
  "publisher": "rorca",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onView:rorcaMcpTools"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Rorca",
      "properties": {
        "rorca.apiUrl": {
          "type": "string",
          "default": "http://localhost:3030",
          "description": "URL of the Rorca backend server",
          "scope": "window"
        },
        "rorca.defaultWorkspacePath": {
          "type": "string",
          "default": "",
          "description": "Default workspace path for this project — overrides workspace autodetection",
          "scope": "resource"
        },
        "rorca.autoRefreshInterval": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 3600,
          "description": "Seconds between automatic MCP tool list refreshes (0 to disable)",
          "scope": "window"
        },
        "rorca.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "Show Rorca connection status in the VS Code status bar",
          "scope": "window"
        },
        "rorca.insertSyntax": {
          "type": "string",
          "enum": ["name-only", "json-call", "slash-command"],
          "default": "name-only",
          "description": "What to insert when clicking Insert at Cursor in the MCP Tools tree: name-only (just the tool name), json-call (full JSON call object), slash-command (/mcp__rorca__tool_name)",
          "scope": "window"
        }
      }
    },
    "viewsContainers": {
      "explorer": [
        {
          "id": "rorca",
          "title": "Rorca",
          "icon": "resources/rorca.svg"
        }
      ]
    },
    "views": {
      "rorca": [
        {
          "id": "rorcaMcpTools",
          "name": "MCP Tools",
          "contextualTitle": "Rorca MCP Tools",
          "when": "true",
          "initialSize": 1
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "rorcaMcpTools",
        "contents": "Connect to Rorca\nStart the Rorca server then click Refresh.\n[Start Server](command:rorca.startServer)\n[Refresh](command:rorca.refreshMcpTools)",
        "when": "!rorca.toolsLoaded"
      }
    ],
    "commands": [
      {
        "command": "rorca.refreshMcpTools",
        "title": "Refresh MCP Tools",
        "category": "Rorca",
        "icon": "$(refresh)"
      },
      {
        "command": "rorca.startServer",
        "title": "Start Server",
        "category": "Rorca",
        "icon": "$(play)"
      },
      {
        "command": "rorca.copyToolName",
        "title": "Copy Tool Name",
        "category": "Rorca",
        "icon": "$(files)"
      },
      {
        "command": "rorca.insertAtCursor",
        "title": "Insert at Cursor",
        "category": "Rorca",
        "icon": "$(insert)"
      },
      {
        "command": "rorca.copyAsMcpCall",
        "title": "Copy as MCP Call",
        "category": "Rorca",
        "icon": "$(json)"
      },
      {
        "command": "rorca.viewDocumentation",
        "title": "View Documentation",
        "category": "Rorca",
        "icon": "$(book)"
      },
      {
        "command": "rorca.testConnection",
        "title": "Test Connection",
        "category": "Rorca",
        "icon": "$(plug)"
      },
      {
        "command": "rorca.forgeFromSelection",
        "title": "Forge from Selection",
        "category": "Rorca",
        "icon": "$(wand)"
      },
      {
        "command": "rorca.runSpec",
        "title": "Run Spec",
        "category": "Rorca",
        "icon": "$(play)"
      }
    ],
    "keybindings": [
      {
        "command": "rorca.forgeFromSelection",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorHasSelection && rorca.serverOnline"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "rorca.refreshMcpTools",
          "when": "view == rorcaMcpTools",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "rorca.copyToolName",
          "when": "viewItem == rorcaMcpTool && view == rorcaMcpTools",
          "group": "inline@1"
        },
        {
          "command": "rorca.insertAtCursor",
          "when": "viewItem == rorcaMcpTool && view == rorcaMcpTools",
          "group": "inline@2"
        },
        {
          "command": "rorca.copyToolName",
          "when": "viewItem == rorcaMcpTool && view == rorcaMcpTools",
          "group": "1_copy@1"
        },
        {
          "command": "rorca.insertAtCursor",
          "when": "viewItem == rorcaMcpTool && view == rorcaMcpTools",
          "group": "1_copy@2"
        },
        {
          "command": "rorca.copyAsMcpCall",
          "when": "viewItem == rorcaMcpTool && view == rorcaMcpTools",
          "group": "1_copy@3"
        },
        {
          "command": "rorca.viewDocumentation",
          "when": "viewItem == rorcaMcpTool && view == rorcaMcpTools",
          "group": "2_docs@1"
        },
        {
          "command": "rorca.startServer",
          "when": "viewItem == rorcaOffline && view == rorcaMcpTools",
          "group": "inline@1"
        }
      ],
      "editor/context": [
        {
          "command": "rorca.forgeFromSelection",
          "when": "editorHasSelection && rorca.serverOnline",
          "group": "rorca@1"
        }
      ],
      "explorer/context": [
        {
          "command": "rorca.runSpec",
          "when": "resourceExtname == .json && rorca.serverOnline",
          "group": "rorca@1"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.3.0"
  }
}
