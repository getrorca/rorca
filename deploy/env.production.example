# Rorca Production Environment Variables
# Copy to .env and fill in all REQUIRED values before deploying.
#
# SECURITY: Never commit .env files to version control.
# Use your platform's secret management (Docker secrets, Railway variables, etc.)

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED — Server will not start safely without these
# ═══════════════════════════════════════════════════════════════════════════════

# OSS Rorca is a private single-operator application, not a hosted multi-user
# auth service. Keep auth disabled and bind the API/UI to loopback/private access.
AUTH_REQUIRED=false
RORCA_BIND_ADDRESS=127.0.0.1
RORCA_PORT=3030

# Strong local secret used for encryption key derivation and internal signing.
# It does not enable a production login flow. Generate with: openssl rand -base64 32
JWT_SECRET=

# Trusted server↔worker HTTP credential. Generate independently from JWT_SECRET:
#   openssl rand -base64 48
# Production startup rejects missing, predictable, or <32-byte values. Internal
# principals are never accepted by provider-mutation middleware.
RORCA_INTERNAL_SERVICE_TOKEN=

# Dedicated receiving-transport credential. Generate independently from every
# other token; the receiver sends it only as Bearer with
# X-Rorca-Service: dispatch-receiver and X-Rorca-Receiver-Id: rorca-dispatch-receiver.
RORCA_DISPATCH_RECEIVER_TOKEN=

# Private operator origin served by the loopback-bound Compose API/UI.
CORS_ORIGIN=http://127.0.0.1:3030
RORCA_BASE_URL=http://127.0.0.1:3030

# Provider changes require an explicit in-memory browser unlock. Configure only
# the SHA-256 digest here; never store the capability preimage in this file.
RORCA_OPERATOR_CAPABILITY_SHA256=

# Signed provider-human issuer bindings. Exact-run closeout reconciliation
# requires an external owner's immutable actor ID in `ownerActorIds`; issuer or
# filesystem access alone never implies ownership, and requester must differ.
# Example shape only: [{"issuerId":"...","keyId":"...","publicKeyPem":"...","provider":"...","providerTenantId":"...","workspaceId":"...","ownerActorIds":["external-owner-id"]}]
RORCA_PROVIDER_HUMAN_ISSUERS_JSON=
# REQUIRED before using historical closeout reconciliation. Inject the exact
# same immutable artifact/deployment receipt into API and worker before startup.
# The service otherwise remains available, but the high-authority protocol fails
# closed when this receipt is absent, malformed, or differs between processes.
# The receipt also binds baseline 407752564e654e1bc8d83af4d9f5154f6807f307,
# Wave 1 spec sha256:caeb0720cd09f4e6a5cd22b078b2d50932b34613262c15631cdf71af9c056920,
# and https://github.com/getrorca/rorca.git. See .env.example for the exact JSON shape.
RORCA_BUILD_IDENTITY_RECEIPT=

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — Defaults shown. Override as needed.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────────────────────────

# Express server port (internal, behind nginx)
# Default: 3030
PORT=3030

# Node environment — enables production optimizations, disables dev logging
# Default: production (set by Docker/compose)
NODE_ENV=production

# Wave-parallel execution is not production-ready. Keep this false.
# Production refuses parallel dispatch even if this is mistakenly set true.
RORCA_EXPERIMENTAL_WAVE_PARALLEL=false

# PostgreSQL split-principal topology. Generate four independent passwords;
# URL-encode password bytes in the three connection URLs. The bootstrap admin
# is used only by `db` and the one-shot `db-role-bootstrap` service and is never
# injected into API/worker. Runtime cannot mutate governed canonical relations;
# only the API's constrained writer can invoke exact transition routines. The
# migration URL is injected only into the one-shot `db-migrate` service; worker
# receives neither owner nor writer credentials.
RORCA_POSTGRES_DATABASE=rorca
RORCA_POSTGRES_BOOTSTRAP_USER=rorca_bootstrap
RORCA_POSTGRES_BOOTSTRAP_PASSWORD=
RORCA_MIGRATION_DATABASE_USER=rorca_migrator
RORCA_MIGRATION_DATABASE_PASSWORD=
RORCA_RUNTIME_DATABASE_USER=rorca_runtime
RORCA_RUNTIME_DATABASE_PASSWORD=
RORCA_CANONICAL_WRITER_DATABASE_USER=rorca_canonical_writer
RORCA_CANONICAL_WRITER_DATABASE_PASSWORD=
RORCA_MIGRATION_DATABASE_URL=postgres://rorca_migrator:URL_ENCODED_PASSWORD@db:5432/rorca
RORCA_RUNTIME_DATABASE_URL=postgres://rorca_runtime:URL_ENCODED_PASSWORD@db:5432/rorca
DATABASE_URL=postgres://rorca_runtime:URL_ENCODED_PASSWORD@db:5432/rorca
RORCA_CANONICAL_WRITER_DATABASE_URL=postgres://rorca_canonical_writer:URL_ENCODED_PASSWORD@db:5432/rorca

# Backend API URL (used by MCP server for self-referencing)
# Default: http://localhost:3030
RORCA_API_URL=http://localhost:3030

# ─── LLM Providers ───────────────────────────────────────────────────────────
# Rorca uses BYOB (Bring Your Own Brain) — you provide the LLM access.
# Choose ONE provider. Default is `claude` (uses Claude CLI with ~/.claude auth).

# Provider: claude (default) | anthropic | openrouter
# - claude: No API key needed, uses `claude --print` CLI
# - anthropic: Requires ANTHROPIC_API_KEY
# - openrouter: Requires OPENROUTER_API_KEY
SPEC_PROVIDER=claude

# Anthropic API key — required if SPEC_PROVIDER=anthropic
# Get from: https://console.anthropic.com/settings/keys
# SECURITY: Treat as a secret. Rotate if exposed.
# ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter API key — required if SPEC_PROVIDER=openrouter
# Get from: https://openrouter.ai/keys
# SECURITY: Treat as a secret. Rotate if exposed.
# OPENROUTER_API_KEY=sk-or-v1-...

# Claude CLI binary path — absolute path required because NVM PATH
# is not inherited by Node child processes.
# Default (macOS NVM): ~/.nvm/versions/node/v20.x.x/bin/claude
# Default (global): /usr/local/bin/claude
# Only needed if SPEC_PROVIDER=claude. Point directly at the verified official
# Claude Code executable; do not use a terminal-app/session wrapper.
# CLAUDE_BIN=/usr/local/bin/claude

# Interactive PTY workers are non-login processes and may not inherit a user's
# package-manager PATH. Configure verified absolute official CLI paths when those
# agents are enabled. Startup remains fail-closed if --version/--help probes fail.
# CODEX_BIN=/usr/local/bin/codex
# OPENCODE_BIN=/usr/local/bin/opencode
# PI_BIN=/usr/local/bin/pi

# Autonomous isolation is fixed by the image/Compose topology with no raw local
# bypass. Every API drafting CLI, worker model CLI, workspace hook, Hilo process,
# and worktree-controlled validation runs with fresh PID/proc/user/mount/network
# namespaces, private HOME/tmp, curated runtime mounts, exact worktree/Git mounts,
# cleared environment, and no DB/provider/localhost network. Launch fails closed
# when bubblewrap or required absolute tools are unavailable.
RORCA_AUTONOMOUS_ISOLATION=linux-bwrap
RORCA_BWRAP_BIN=/usr/bin/bwrap
# Exact HTTPS CONNECT destinations for model inference. The trusted API/worker
# brokers resolve/pin only public addresses and accept CONNECT :443 only. This
# is not a general proxy and never permits GitHub, DB, localhost, IP literals,
# wildcards, or arbitrary ports. Add exact vendor hosts only after review.
RORCA_AUTONOMOUS_MODEL_EGRESS_HOSTS=api.anthropic.com,api.openai.com,openrouter.ai,generativelanguage.googleapis.com
# Optional colon-separated root-owned, non-writable tool roots. Never include /,
# /root, /home, /etc, /run, credential directories, or workspace parents.
# RORCA_AUTONOMOUS_TOOL_ROOTS=/usr:/opt/rorca-tools

# Pre-staging qualification is worker-only and fails closed unless its immutable
# toolchain descriptor and sandbox identity are pinned. The toolchain digest is
# SHA-256 over <root>/rorca-qualification-toolchain.json.
RORCA_QUALIFICATION_TOOLCHAIN_ROOT=/opt/rorca/qualification-toolchain
RORCA_QUALIFICATION_TOOLCHAIN_DIGEST=sha256:REPLACE_WITH_64_LOWERCASE_HEX
# Linux deployments use root-owned bubblewrap and verify the executable bytes.
RORCA_QUALIFICATION_BWRAP_BIN=/usr/bin/bwrap
RORCA_QUALIFICATION_BWRAP_DIGEST=sha256:REPLACE_WITH_64_LOWERCASE_HEX
# Darwin workers instead require Docker and a locally inspected immutable image.
# RORCA_QUALIFICATION_DOCKER_BIN=/usr/local/bin/docker
# RORCA_QUALIFICATION_DOCKER_IMAGE=sha256:REPLACE_WITH_64_LOWERCASE_HEX

# ─── GitHub Integration (optional) ───────────────────────────────────────────
# For local repository actions, prefer GITHUB_TOKEN / GH_TOKEN or existing `gh auth` credentials.
# GITHUB_TOKEN=ghp_...
# GH_TOKEN=ghp_...

# ─── Backup ──────────────────────────────────────────────────────────────────
# Directory for automated PostgreSQL backups (pg_dump).
# Default: /data/backups
# BACKUP_DIR=/data/backups
