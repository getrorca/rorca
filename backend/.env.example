# ─── Core Backend Configuration ───
PORT=3030
DATABASE_URL=postgres://rorca:rorca@localhost:5432/rorca
NODE_ENV=development

# ─── Supabase (local Supabase CLI) ───
# Frontend callback / API URL: http://127.0.0.1:54321
# Studio: http://127.0.0.1:54323
# DB: postgres://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<local anon key>
SUPABASE_SERVICE_ROLE_KEY=<local service role key>

# ─── Authentication ───
# Set to 'true' to enforce JWT authentication on all protected routes.
# Default (false/absent): no-op, preserving local single-user behavior.
AUTH_REQUIRED=false

# ─── Execution Engine ───
# Three execution paths — choose one:
# 1. RORCA_AGENT=claude (default) — uses local Claude subscription via `claude --print`
# 2. RORCA_AGENT=opencode — uses OpenCode CLI with provider API key (RORCA_MODEL required)
# 3. RORCA_AGENT=codex — uses Codex CLI with ChatGPT subscription
RORCA_AGENT=claude

# For OpenCode: specify model as "provider/model" (e.g. openai/gpt-4o, google/gemini-2.0-flash)
# Ignored for claude and codex agents.
RORCA_MODEL=openai/gpt-4o

# Path to OpenCode binary (auto-detected from PATH if not set)
OPENCODE_BIN=

# Path to Codex binary (auto-detected from PATH if not set)
CODEX_BIN=

# ─── Spec Generation Provider ───
# Used when RORCA_AGENT=claude or as SDK fallback for context-intensive tasks
# Options: claude (default, uses CLI), anthropic (API), openrouter (multi-model API)
SPEC_PROVIDER=claude

# API keys for spec generation (required if SPEC_PROVIDER is not claude)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ─── Rate Limiting Configuration ───
# Production tuning for legitimate users vs. abuse prevention.
#
# Default limits (stored in database, see backend/src/db/migrations/027_rate_limits.sql):
# - Authenticated users: 100 requests per minute (across all endpoints)
# - Unauthenticated users: 20 requests per minute (across all endpoints)
# - Heavy endpoints (spec generation, pipeline trigger): 10/min authenticated, 3/min unauthenticated
#
# Exempt endpoints (not rate-limited, suitable for monitoring):
# - GET /api/health — Docker, Kubernetes, load balancers poll frequently
# - GET /api/pipeline/stream — SSE event stream (long-lived connection)
# - GET /api/pipeline/runs/:id/output — SSE terminal output (long-lived connection)
# - GET /api/pipeline/runs/:id/stories/:storyId/output — SSE story output
# - GET /api/pipeline/runs/:id/stories/:storyId/log — SSE story log
#
# To change rate limits at runtime:
# 1. Update database: UPDATE rate_limits SET max_requests=500 WHERE endpoint_pattern='*' AND tier='authenticated';
# 2. Invalidate cache: the system reloads every 30 seconds automatically, or restart backend immediately
#
# To debug rate limiting on a per-request basis:
RATE_LIMIT_DEBUG=false

# ─── Static Frontend Serving (Self-Hosted Mode) ───
# When using `rorca start` CLI, set these to serve frontend from same process:
RORCA_SERVE_STATIC=0
RORCA_STATIC_DIR=./dist

# ─── CORS ───
# Allowed origin(s) for cross-origin requests. Supports comma-separated list.
#
# Examples:
#   Single origin:   CORS_ORIGIN=https://app.rorca.app
#   Multiple:        CORS_ORIGIN=https://app.rorca.app,https://rorca.app
#   Dev default:     CORS_ORIGIN=http://localhost:5210
#   Wildcard (*):    allows any origin but disables credential forwarding (cookies, Authorization)
#
# In production (NODE_ENV=production), if CORS_ORIGIN is unset or '*', the server logs:
#   WARNING: CORS_ORIGIN not configured — API accessible from any origin
#
# Note: credentials (cookies, Authorization headers) are only forwarded when a specific
# origin is configured. Wildcard '*' disables credential support per the CORS spec.
CORS_ORIGIN=http://localhost:5210

# ─── Logging ───
# Structured logging via pino-http
LOG_LEVEL=info

# ─── Database Query Timing (Performance Audit) ───
# Logs any query taking longer than this threshold (ms)
QUERY_TIMER_THRESHOLD_MS=100

# ─── Telemetry & Analytics ───
# Anonymous telemetry opt-out flag
TELEMETRY_DISABLED=false

# ─── GitHub Integration ───
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# ─── Stripe Integration ───
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Email & Notifications ───
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ─── Worker Settings ───
# How often (ms) the worker polls worker_settings for max_concurrent_runs changes.
# When the DB value changes, the worker hot-reloads its pipeline:run subscription
# without restarting the process or interrupting in-flight jobs.
# Default: 30000 (30 seconds)
WORKER_SETTINGS_POLL_MS=30000

# ─── Browser MCP (rorca-browser-mcp-integration) ───
# Set to 'false' to show browser window during E2E stories (default: headless)
# RORCA_BROWSER_HEADLESS=false

# ─── Feature Flags ───
# Enable experimental features (use with caution)
FEATURE_WAVE_EXECUTION=false
FEATURE_AGENT_PERSONAS=false
FEATURE_CONVENTION_PACKS=false
