# ─── Core Backend Configuration ───
PORT=3030
# Ordinary runtime principal: read/application access only; no canonical Wave 2 DML.
# native | docker | byop — see ../.env.example for the full guide
RORCA_DB_MODE=native
RORCA_PG_PORT=5433
DATABASE_URL=postgres://rorca_runtime:change-me@localhost:5432/rorca
# Distinct migration owner and constrained canonical source-writer principals.
RORCA_MIGRATION_DATABASE_URL=postgres://rorca_migrator:change-me@localhost:5432/rorca
RORCA_RUNTIME_DATABASE_USER=rorca_runtime
RORCA_CANONICAL_WRITER_DATABASE_URL=postgres://rorca_canonical_writer:change-me@localhost:5432/rorca
RORCA_CANONICAL_WRITER_DATABASE_USER=rorca_canonical_writer
NODE_ENV=development

# ─── Authentication ───
# Default local-first OSS mode keeps auth bypassed for a single local operator.
AUTH_REQUIRED=false
JWT_SECRET=change-me-for-non-local-deployments
# Shared cryptographic server/worker credential (>=32 unpredictable bytes).
RORCA_INTERNAL_SERVICE_TOKEN=
# Digest only; never place the operator capability preimage in an env file.
RORCA_OPERATOR_CAPABILITY_SHA256=
# AES-256-GCM key for provider-neutral credential SecretStore objects. Generate
# exactly 32 random bytes as 64 hex characters and keep it outside agent/runtime prompts.
RORCA_CREDENTIAL_STORE_KEY=
# Ed25519 public-key bindings for isolated Stripe Dashboard operator evidence.
# [{"keyId":"...","publicKeyPem":"...","workspaceId":"...","accountId":"acct_...","operatorIds":["..."],"modes":["test"]}]
RORCA_STRIPE_DASHBOARD_EVIDENCE_KEYS_JSON=
# Experimental authenticated browser session broker. Keep disabled until the
# deployment has an isolated browser runner. Key: exactly 32 random bytes in
# base64 (`openssl rand -base64 32`), trusted server/runner environment only.
RORCA_BROWSER_SESSION_BROKER_ENABLED=false
RORCA_BROWSER_PROFILE_MASTER_KEY=
# Ciphertext-only profile artifacts; never place this inside a workspace.
RORCA_BROWSER_PROFILE_STORE_DIR=


# ─── Execution Engine ───
# 1. claude   — local Claude subscription via `claude --print`
# 2. opencode — OpenCode CLI with provider API key (RORCA_MODEL required)
# 3. codex    — Codex CLI with ChatGPT subscription
# 4. pi       — Pi CLI (`npm install -g @mariozechner/pi-coding-agent`)
# 5. omp      — qualified Oh My Pi sandbox executor
RORCA_AGENT=claude
RORCA_MODEL=openai/gpt-4o
OPENCODE_BIN=
CODEX_BIN=
PI_BIN=
OMP_BIN=
# Enable only after the MIG-001 sandbox qualification suite passes for this
# deployment. Without both this marker and an installed OMP v17+, implicit runs
# retain the configured fallback; explicit executor overrides still work.
RORCA_OMP_SANDBOX_QUALIFIED=false
# Darwin hosts: PI_BIN/OMP_BIN must be absolute executable paths. Qualified OMP
# uses the same ordinary-local sandbox profile; explicit Pi remains supported.
CLAUDE_BIN=
# Mandatory for every model/tool/workspace-code subprocess on Linux. Darwin uses
# the ordinary local Pi profile instead of bwrap; Linux keeps this boundary.
RORCA_AUTONOMOUS_ISOLATION=linux-bwrap
RORCA_BWRAP_BIN=/usr/bin/bwrap
# Required on production Linux/macOS for descriptor-relative workspace
# filesystem operations. Windows is intentionally unsupported for this boundary.
RORCA_PYTHON_BIN=/usr/bin/python3
RORCA_AUTONOMOUS_MODEL_EGRESS_HOSTS=api.anthropic.com,api.openai.com,openrouter.ai,generativelanguage.googleapis.com

# ─── Spec Generation Provider ───
SPEC_PROVIDER=claude

# ─── Provider API Keys ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=

# Optional GitHub repository access for local workflows / PR automation
GITHUB_TOKEN=
GH_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ─── Execution Authority Secret Store ───
# Existing encrypted PostgreSQL vault; zero-network and always the default.
RORCA_AUTHORITY_SECRET_STORE=database
# Infisical is opt-in. Endpoint configuration contains no credential; the
# trusted host must inject an authenticated transport explicitly.
RORCA_AUTHORITY_INFISICAL_ENDPOINT=https://app.infisical.com
RORCA_AUTHORITY_INFISICAL_TIMEOUT_MS=2000
RORCA_AUTHORITY_INFISICAL_MAX_STALENESS_MS=60000
# Explicitly prevents all Infisical network resolution and revocation.
RORCA_AUTHORITY_INFISICAL_OFFLINE=false

# ─── Graph Scoring Rollout ───
RORCA_GRAPH_SCORING_ENABLED=false
RORCA_GRAPH_SCORING_WEIGHT=

# ─── Static Frontend Serving (Self-Hosted Mode) ───
RORCA_SERVE_STATIC=0
RORCA_STATIC_DIR=./dist

# ─── CORS ───
CORS_ORIGIN=http://localhost:5210

# ─── Logging ───
LOG_LEVEL=info
QUERY_TIMER_THRESHOLD_MS=100

# ─── Telemetry & Analytics ───
TELEMETRY_DISABLED=false

# ─── Email & Notifications (removed in the OSS edition) ───
# Hosted email (verification, password reset, invites, run-complete) belongs to
# the hosted product. No email transport is configured or read by this backend.

# ─── Licensing (optional) ───
RORCA_LICENSE_KEY=
