{
  "name": "rorca-backend",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "npx tsx src/server.ts",
    "dev:server": "npx tsx src/server.ts",
    "dev:worker": "npx tsx src/worker.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/run-isolated-jest.ts",
    "test:complete-orchestration": "tsx --test scripts/__tests__/complete-jest-orchestrator.node.test.ts",
    "verify:ssdlc-contracts": "node --import tsx --test src/ssdlc/interop/__tests__/contract-registry.node.test.ts src/ssdlc/interop/__tests__/executor-recovery-compatibility.node.test.ts && node --import tsx scripts/write-ssdlc-contract-registry-receipt.ts",
    "verify:ssdlc-interoperability": "node --import tsx --test src/ssdlc/__tests__/full-interoperability-qualification.node.test.ts",
    "verify:omp-session-visibility": "node --import tsx --test src/lib/__tests__/omp-session-store.node.test.ts",
    "test:db-safety-live": "tsx scripts/run-isolated-jest.ts src/lib/__tests__/test-db-safety-live.integration.test.ts --runInBand",
    "test:pg-boss-cancel": "tsx scripts/run-isolated-jest.ts --config jest.pg-boss.config.ts src/__tests__/pg-boss-cancel.test.ts --runInBand",
    "test:integration": "tsx scripts/run-isolated-jest.ts --config jest.pg-boss.config.ts --runInBand",
    "test:golden": "node --import tsx --test src/__tests__/golden-terminal-contract.node.test.ts && node scripts/run-golden-tests.js",
    "test:golden:update": "node --import tsx --test src/__tests__/golden-terminal-contract.node.test.ts && node scripts/run-golden-tests.js --update-golden",
    "test:ssdlc-gates": "node --import tsx --test src/ssdlc/gates/__tests__/gate-compiler.node.test.ts src/ssdlc/evaluation/__tests__/gate-evaluator.node.test.ts",
    "test:populated-upgrade": "tsx scripts/run-isolated-jest.ts src/db/__tests__/ssdlc-7-phase-collapse-migration.test.ts --runInBand",
    "test:harness": "node --test scripts/__tests__/run-golden-tests.test.js && tsx --test scripts/__tests__/complete-jest-orchestrator.node.test.ts",
    "soak:pty": "tsx scripts/pty-v2-soak.ts",
    "benchmark:pty-release": "tsx scripts/pty-noisy-release.ts",
    "certify:strict-memory-linux": "tsx scripts/certify-strict-memory-linux.ts",
    "test:pty-release": "tsx --test scripts/__tests__/pty-noisy-release-harness.test.ts",
    "typecheck:pty-release": "tsc -p tsconfig.release-harness.json",
    "mcp": "npx tsx src/mcp/server.ts",
    "lint": "npx eslint src/",
    "worker": "npx tsx src/worker-supervisor.ts",
    "worker:bounty": "npx tsx src/bounty-worker.ts",
    "reconcile": "npx tsx src/reconcile-daemon-cli.ts",
    "backfill:story-accounting": "tsx scripts/backfill-story-accounting.ts",
    "backfill:spec-export-kits": "tsx scripts/backfill-spec-export-kits.ts",
    "runner:local": "npx tsx src/runner/local-runner.ts",
    "verify:node-pty": "node scripts/verify-node-pty-install.js",
    "test:install-lifecycle": "node --test scripts/__tests__/install-dependencies.test.js",
    "postinstall": "npm run verify:node-pty"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/mcp": "0.0.78",
    "@types/helmet": "^0.0.48",
    "@types/multer": "^2.0.0",
    "@types/ws": "^8.18.1",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "chokidar": "^5.0.0",
    "chrome-devtools-mcp": "^1.6.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "cron-parser": "^5.5.0",
    "dotenv": "^16.4.7",
    "express": "4.22.2",
    "helmet": "^8.1.0",
    "ink": "^3.2.0",
    "ink-text-input": "^4.0.3",
    "js-yaml": "^4.3.1",
    "jsonwebtoken": "^9.0.3",
    "mammoth": "1.12.0",
    "micromatch": "^4.0.8",
    "multer": "2.2.0",
    "node-pty": "^1.1.0",
    "nodemailer": "9.0.3",
    "openai": "^6.24.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "pg-boss": "^10.4.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "playwright": "^1.52.0",
    "react": "^17.0.2",
    "simple-git": "3.36.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "8.21.1",
    "zod": "^4.3.6"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "hono": "4.13.0",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.1"
    },
    "ip-address": "10.4.0",
    "ink": {
      "ws": "7.5.11"
    },
    "react-devtools-core": {
      "ws": "7.5.11"
    }
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.18.0",
    "@types/pino-http": "^5.8.4",
    "@types/react": "^17.0.89",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "ajv": "^8.17.1",
    "eslint": "^10.0.3",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
