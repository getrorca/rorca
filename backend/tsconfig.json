{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "types": ["node", "jest"]
  },
  "include": ["src"],
  "exclude": ["src/db/bun-sqlite-shim.ts", "src/**/__tests__/**", "src/**/*.test.ts"]
}
