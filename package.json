{
  "name": "rorca",
  "version": "0.1.0",
  "description": "AI spec orchestration pipeline — turn plain-English briefs into validated, executed code",
  "type": "module",
  "bin": {
    "rorca": "./bin/rorca.js"
  },
  "scripts": {
    "dev": "concurrently \"vite\" \"cd backend && npx tsx src/server.ts\"",
    "build": "vite build && cd backend && tsc && cd .. && npx tsc --project bin/tsconfig.json",
    "typecheck": "tsc --noEmit && cd backend && tsc --noEmit",
    "self-register": "npx tsx forge/self-register.ts",
    "start": "node cli.js start",
    "postinstall": "cd backend && npm install --production --ignore-scripts 2>/dev/null || true",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "spec",
    "orchestration",
    "pipeline",
    "claude",
    "llm",
    "development"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin/rorca.js",
    "cli.js",
    "dist/",
    "backend/dist/",
    "backend/src/db/migrations/",
    "backend/package.json",
    "backend/package-lock.json",
    "forge/run-loop.sh",
    "forge/self-register.ts",
    "package.json"
  ],
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@monaco-editor/react": "^4.7.0",
    "@rollup/rollup-darwin-arm64": "^4.59.0",
    "@tanstack/react-virtual": "^3.13.19",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.575.0",
    "mermaid": "^11.12.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.53",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^4.0.18"
  }
}
