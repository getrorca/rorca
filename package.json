{
  "name": "rorca",
  "version": "0.1.0",
  "description": "AI spec orchestration pipeline — turn plain-English briefs into validated, executed code",
  "type": "module",
  "bin": {
    "rorca": "./bin/rorca.js"
  },
  "scripts": {
    "dev": "concurrently --names frontend,server,worker \"npm run dev:frontend\" \"npm run dev:server\" \"npm run dev:worker\"",
    "dev:frontend": "vite",
    "dev:server": "cd backend && npx tsx src/server.ts",
    "dev:worker": "cd backend && npx tsx src/worker.ts",
    "build": "vite build && cd backend && tsc && cd .. && npx tsc --project bin/tsconfig.json",
    "typecheck": "tsc --noEmit && cd backend && tsc --noEmit",
    "lint": "npx eslint src/",
    "lint:swagger": "npx tsx scripts/check-swagger-coverage.ts",
    "changelog": "npx tsx scripts/generate-changelog.ts",
    "self-register": "npx tsx forge/self-register.ts",
    "start": "node cli.js start",
    "postinstall": "cd backend && npm install --production --ignore-scripts 2>/dev/null || true",
    "prepublishOnly": "npm run build",
    "test:e2e:first-run": "npx tsx test/e2e/first-run.test.ts"
  },
  "keywords": [
    "ai",
    "spec",
    "orchestration",
    "pipeline",
    "claude",
    "llm",
    "development"
  ],
  "license": "BSL-1.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin/rorca.js",
    "cli.js",
    "dist/",
    "backend/dist/",
    "backend/src/db/migrations/",
    "backend/package.json",
    "backend/package-lock.json",
    "forge/run-loop.sh",
    "forge/self-register.ts",
    "package.json"
  ],
  "dependencies": {
    "@dagrejs/dagre": "^2.0.4",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-virtual": "^3.13.19",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ansi-to-html": "^0.7.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.35.1",
    "lucide-react": "^0.575.0",
    "mermaid": "^11.12.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.13.1",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.53",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.11.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^4.0.18",
    "vitest-axe": "^0.1.0"
  }
}
