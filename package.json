{
  "name": "rorca",
  "version": "0.1.0",
  "description": "AI spec orchestration pipeline — turn plain-English briefs into validated, executed code",
  "type": "module",
  "bin": {
    "rorca": "./bin/rorca.js"
  },
  "scripts": {
    "dev": "node scripts/dev-smart.mjs",
    "dev:full": "concurrently --names frontend,server,worker \"npm run dev:frontend\" \"npm run dev:server\" \"npm run dev:worker:optional\"",
    "dev:frontend": "vite",
    "dev:frontend-only": "vite",
    "dev:server": "cd backend && npx tsx src/server.ts",
    "dev:worker": "cd backend && npx tsx src/worker.ts",
    "dev:worker:optional": "cd backend && RORCA_OPTIONAL_WORKER=true npx tsx src/worker.ts",
    "build": "vite build && cd backend && tsc && cd .. && npx tsc --project bin/tsconfig.json",
    "typecheck": "tsc --noEmit && cd backend && tsc --noEmit",
    "lint": "npx eslint src/",
    "lint:swagger": "npx tsx scripts/check-swagger-coverage.ts",
    "changelog": "npx tsx scripts/generate-changelog.ts",
    "self-register": "npx tsx forge/self-register.ts",
    "start": "node cli.js start",
    "postinstall": "cd backend && npm install --production --ignore-scripts 2>/dev/null || true",
    "prepublishOnly": "npm run build",
    "test:e2e:first-run": "npx tsx test/e2e/first-run.test.ts",
    "auth:test": "npx playwright test tests/auth.spec.ts"
  },
  "keywords": [
    "ai",
    "spec",
    "orchestration",
    "pipeline",
    "claude",
    "llm",
    "development"
  ],
  "license": "BSL-1.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin/rorca.js",
    "cli.js",
    "dist/",
    "backend/dist/",
    "backend/src/db/migrations/",
    "backend/package.json",
    "backend/package-lock.json",
    "forge/run-loop.sh",
    "forge/self-register.ts",
    "package.json"
  ],
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@modelcontextprotocol/client": "^2.0.0-alpha.2",
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.104.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/react-virtual": "^3.13.24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.20.0-beta.196",
    "@xterm/xterm": "6.1.0-beta.197",
    "ansi-to-html": "^0.7.2",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.11.0",
    "mermaid": "^11.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.11.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0"
  }
}
