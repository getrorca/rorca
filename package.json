{
  "name": "rorca",
  "version": "1.0.0",
  "description": "AI spec orchestration pipeline — turn plain-English briefs into validated, executed code",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "rorca": "./bin/rorca.js",
    "rorca-capture": "./bin/rorca-capture.js"
  },
  "scripts": {
    "dev": "node scripts/dev-smart.mjs",
    "dev:full": "concurrently --names frontend,server,worker \"npm run dev:frontend\" \"npm run dev:server\" \"npm run dev:worker:optional\"",
    "dev:frontend": "vite",
    "dev:frontend-only": "vite",
    "dev:server": "cd backend && npx tsx src/server.ts",
    "dev:server:contract": "cd backend && RORCA_DISABLE_BACKGROUND_RUNTIME=true npx tsx src/server.ts",
    "dev:worker": "cd backend && npx tsx src/worker.ts",
    "dev:worker:optional": "cd backend && RORCA_OPTIONAL_WORKER=true npx tsx src/worker.ts",
    "build": "vite build && cd backend && tsc && cd .. && npx tsc --project bin/tsconfig.json",
    "build:contract": "npx tsx scripts/build-public-contract.ts",
    "check:contract": "npx tsx scripts/check-contract-stability.ts",
    "check:licenses": "npx tsx scripts/check-license-headers.ts",
    "check:license-boundaries": "npx tsx scripts/check-license-boundaries.ts",
    "split:check": "npx tsx scripts/check-opencore-export.ts",
    "sync:push": "node scripts/sync-opencore-push.mjs",
    "typecheck": "tsc --noEmit && cd backend && tsc --noEmit && cd .. && npx tsc -p packages/rorca-pi-extension/tsconfig.json --noEmit && npx tsc -p packages/rorca-public-contract/tsconfig.json --noEmit",
    "test:pi-extension": "npx vitest run --config packages/rorca-pi-extension/vitest.config.ts",
    "test:capture": "npx vitest run --config packages/rorca-pi-extension/vitest.config.ts packages/rorca-pi-extension/extensions/rorca/__tests__/capture-compatibility-e2e.test.ts && cd backend && JEST_SKIP_RUNTIME_MIGRATIONS=true npx jest src/lib/__tests__/context-distillation.test.ts src/routes/__tests__/context-capture-validation.test.ts --runInBand",
    "lint": "npx eslint src/",
    "lint:swagger": "npx tsx scripts/check-swagger-coverage.ts",
    "lint:tier": "npx tsx scripts/check-rorca-tier-annotations.ts",
    "changelog": "npx tsx scripts/generate-changelog.ts",
    "self-register": "npx tsx forge/self-register.ts",
    "start": "node cli.js start",
    "postinstall": "node backend/scripts/install-dependencies.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build",
    "test:e2e:first-run": "npx tsx test/e2e/first-run.test.ts",
    "auth:test": "npx playwright test tests/auth.spec.ts"
  },
  "keywords": [
    "ai",
    "spec",
    "orchestration",
    "pipeline",
    "claude",
    "llm",
    "development"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin/rorca.js",
    "bin/rorca-capture.js",
    "cli.js",
    "dist/",
    "backend/dist/",
    "backend/src/db/pg-migrations/",
    "backend/package.json",
    "backend/package-lock.json",
    "backend/scripts/install-dependencies.js",
    "backend/scripts/verify-node-pty-install.js",
    "packages/rorca-pi-extension/",
    "forge/run-loop.sh",
    "forge/self-register.ts",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "overrides": {
    "dompurify": "3.4.12"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@modelcontextprotocol/client": "^2.0.0-alpha.2",
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@tanstack/react-virtual": "^3.13.24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "0.20.0-beta.196",
    "@xterm/xterm": "6.1.0-beta.197",
    "ansi-to-html": "^0.7.2",
    "commander": "^12.1.0",
    "date-fns": "^4.1.0",
    "execa": "^9.6.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.11.0",
    "mermaid": "^11.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-is": "^19.2.5",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dagre": "^0.7.54",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "axe-core": "^4.11.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "vitest-axe": "^0.1.0"
  }
}
