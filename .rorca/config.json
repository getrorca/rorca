{
  "$schema": "./config.schema.json",
  "version": 1,
  "routing": {
    "global": [
      "CLAUDE.md",
      "AGENTS.md"
    ],
    "scopes": [
      {
        "path": "src/panels/**",
        "inject": ["react.md", "tailwind.md"],
        "priority": 50,
        "managed": "manual"
      },
      {
        "path": "src/components/**",
        "inject": ["react.md", "tailwind.md"],
        "priority": 50,
        "managed": "manual"
      },
      {
        "path": "src/contexts/**",
        "inject": ["react.md"],
        "priority": 40,
        "managed": "manual"
      },
      {
        "path": "src/hooks/**",
        "inject": ["react.md"],
        "priority": 40,
        "managed": "manual"
      },
      {
        "path": "backend/src/routes/**",
        "inject": [],
        "priority": 60,
        "managed": "manual"
      },
      {
        "path": "backend/src/lib/**",
        "inject": [],
        "priority": 70,
        "managed": "manual"
      },
      {
        "path": "backend/src/db/**",
        "inject": [],
        "priority": 60,
        "managed": "manual"
      },
      {
        "path": "forge/**",
        "inject": [],
        "priority": 30,
        "managed": "manual"
      }
    ],
    "tags": [
      {
        "tag": "frontend",
        "inject": ["react.md", "tailwind.md"]
      },
      {
        "tag": "ui",
        "inject": ["react.md", "tailwind.md"]
      }
    ],
    "tokenBudget": 32000
  },
  "context": {
    "fileRegistry": [
      { "path": "CLAUDE.md", "role": "context" },
      { "path": "AGENTS.md", "role": "governance" },
      { "path": "MEMORY.md", "role": "memory" },
      { "path": ".rorca/skills/react.md", "role": "skill" },
      { "path": ".rorca/skills/tailwind.md", "role": "skill" }
    ],
    "memory": {
      "ledgerPath": ".rorca/memory/MEMORY.md",
      "maxEntries": 500,
      "autoCapture": true
    },
    "retrieval": {
      "graphScoreWeight": 0
    }
  },
  "teleology": {
    "specDir": "forge/specs",
    "directionStackLayers": [
      "L1",
      "L2",
      "L3",
      "L4",
      "L5"
    ]
  },
  "orchestration": {
    "router": "auto",
    "thresholds": {
      "haiku": [
        0,
        30
      ],
      "sonnet": [
        31,
        65
      ],
      "opus": [
        66,
        100
      ]
    },
    "escalation": {
      "enabled": true,
      "maxRetriesOnTier": 2,
      "chain": [
        "haiku",
        "sonnet",
        "opus"
      ]
    },
    "tokenBudgetPerStory": 50000,
    "fallbackEngine": null,
    "capabilityMismatch": "warn"
  },
  "execution": {
    "waveParallelism": true,
    "storyTimeoutMin": 45,
    "maxRetries": 3,
    "autoCommit": true,
    "adversarialReview": {
      "enabled": false,
      "reviewTimeoutMin": 5
    }
  },
  "personas": {
    "disabled": []
  }
}