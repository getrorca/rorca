{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rorca.app/schemas/config.schema.json",
  "title": "Rorca Project Configuration",
  "description": "Configuration for .rorca/config.json — orchestration, context routing, and project metadata.",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Schema version. Increment on breaking changes."
    },
    "routing": {
      "type": "object",
      "description": "Virtual context routing — controls which files are injected into story prompts.",
      "properties": {
        "global": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["CLAUDE.md", "AGENTS.md"],
          "description": "Files always injected into every story prompt, relative to workspace root."
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Glob pattern matching story file paths (e.g. 'src/components/**')."
              },
              "inject": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Skill files to inject when this scope matches (relative to .rorca/skills/)."
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100,
                "default": 50,
                "description": "Higher priority wins on conflict. Globals are always priority 999."
              },
              "managed": {
                "type": "string",
                "enum": ["rorca", "manual", "hybrid"],
                "default": "rorca",
                "description": "'rorca': auto-managed by scaffold generator. 'manual': user-managed. 'hybrid': auto-generated, user-editable."
              }
            },
            "required": ["path", "inject"],
            "additionalProperties": false
          },
          "default": [],
          "description": "Path-scoped context injection rules. Matched against story description and file mentions."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "tag": {
                "type": "string",
                "description": "Tag name to match against story tags."
              },
              "inject": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Skill files to inject when tag matches (relative to .rorca/skills/)."
              }
            },
            "required": ["tag", "inject"],
            "additionalProperties": false
          },
          "default": [],
          "description": "Tag-based context injection rules. Tags are always additive (never override scopes)."
        },
        "tokenBudget": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 200000,
          "default": 8000,
          "description": "Max tokens for injected context per story. Lowest-priority scoped files dropped first; globals never dropped."
        }
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "description": "Context layer — 'The Is': what the codebase IS (ontology).",
      "properties": {
        "fileRegistry": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "description": "Relative path from workspace root."
              },
              "role": {
                "type": "string",
                "enum": ["context", "skill", "memory", "template", "governance"],
                "description": "File role in the orchestration system."
              },
              "managed": {
                "type": "string",
                "enum": ["rorca", "manual", "hybrid"],
                "default": "rorca"
              }
            },
            "required": ["path", "role"],
            "additionalProperties": false
          },
          "default": [],
          "description": "Registry of all orchestration-relevant files in the workspace."
        },
        "memory": {
          "type": "object",
          "properties": {
            "ledgerPath": {
              "type": "string",
              "default": ".rorca/memory/MEMORY.md",
              "description": "Path to the episodic memory ledger."
            },
            "maxEntries": {
              "type": "integer",
              "minimum": 10,
              "default": 500,
              "description": "Max entries before oldest are pruned."
            },
            "autoCapture": {
              "type": "boolean",
              "default": true,
              "description": "Automatically capture decisions from completed stories."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "teleology": {
      "type": "object",
      "description": "Intent layer — 'The Ought': what should be built (teleology).",
      "properties": {
        "specDir": {
          "type": "string",
          "default": "forge/specs",
          "description": "Root directory for spec JSON files relative to workspace root."
        },
        "directionStackLayers": {
          "type": "array",
          "items": { "type": "string", "enum": ["L1", "L2", "L3", "L4", "L5"] },
          "default": ["L1", "L2", "L3", "L4", "L5"],
          "description": "Active direction stack layers for this workspace."
        },
        "defaultModel": {
          "type": "string",
          "description": "Default LLM model for spec generation and execution."
        }
      },
      "additionalProperties": false
    },
    "orchestration": {
      "type": "object",
      "description": "Model routing, tier assignment, escalation, and task-type cascade configuration.",
      "properties": {
        "router": {
          "type": "string",
          "enum": ["auto", "fixed", "manual"],
          "default": "auto",
          "description": "Router mode. 'auto': complexity scorer assigns tier. 'fixed': use spec model for all stories. 'manual': per-story modelTier overrides in spec JSON."
        },
        "thresholds": {
          "type": "object",
          "description": "Complexity score boundaries for model tier assignment. Scores 0-100.",
          "properties": {
            "haiku": {
              "oneOf": [
                { "type": "number", "minimum": 0, "maximum": 100 },
                {
                  "type": "array",
                  "items": { "type": "number", "minimum": 0, "maximum": 100 },
                  "minItems": 2,
                  "maxItems": 2
                }
              ],
              "default": [0, 30]
            },
            "sonnet": {
              "oneOf": [
                { "type": "number", "minimum": 0, "maximum": 100 },
                {
                  "type": "array",
                  "items": { "type": "number", "minimum": 0, "maximum": 100 },
                  "minItems": 2,
                  "maxItems": 2
                }
              ],
              "default": [31, 65]
            },
            "opus": {
              "oneOf": [
                { "type": "number", "minimum": 0, "maximum": 100 },
                {
                  "type": "array",
                  "items": { "type": "number", "minimum": 0, "maximum": 100 },
                  "minItems": 2,
                  "maxItems": 2
                }
              ],
              "default": [66, 100]
            }
          },
          "additionalProperties": false
        },
        "cascades": {
          "type": "object",
          "description": "Provider-specific model IDs for each tier.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "haiku": { "type": "string" },
              "sonnet": { "type": "string" },
              "opus": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "taskCascades": {
          "type": "object",
          "description": "Default model ID per task type.",
          "properties": {
            "echolocation": { "type": "string" },
            "planning": { "type": "string" },
            "coding": { "type": "string" },
            "lintFix": { "type": "string" },
            "testing": { "type": "string" },
            "documentation": { "type": "string" }
          },
          "additionalProperties": false
        },
        "escalation": {
          "type": "object",
          "description": "Cascading escalation behavior when a story fails on its assigned tier.",
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "maxRetriesOnTier": { "type": "integer", "minimum": 0, "default": 2 },
            "chain": {
              "type": "array",
              "items": { "type": "string", "enum": ["haiku", "sonnet", "opus"] },
              "default": ["haiku", "sonnet", "opus"]
            },
            "escalateTo": {
              "type": "object",
              "additionalProperties": {
                "oneOf": [
                  { "type": "string", "enum": ["haiku", "sonnet", "opus"] },
                  { "type": "null" }
                ]
              }
            }
          },
          "additionalProperties": false
        },
        "tokenBudgetPerStory": {
          "type": "number",
          "minimum": 1000,
          "default": 50000,
          "description": "Maximum input tokens per story before warning."
        },
        "fallbackEngine": {
          "oneOf": [
            { "type": "string", "enum": ["claude", "opencode", "codex"] },
            { "type": "null" }
          ],
          "default": null,
          "description": "Secondary engine for rate limit overflow rerouting."
        },
        "capabilityMismatch": {
          "type": "string",
          "enum": ["warn", "reroute", "block"],
          "default": "warn",
          "description": "How to handle stories requiring tools the engine doesn't support."
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "description": "Pipeline execution settings.",
      "properties": {
        "waveParallelism": {
          "type": "boolean",
          "default": false,
          "description": "Enable wave-based parallel story execution."
        },
        "storyTimeoutMin": {
          "type": "integer",
          "minimum": 1,
          "default": 45,
          "description": "Story timeout in minutes."
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "default": 3,
          "description": "Max retries per story before marking as failed."
        },
        "autoCommit": {
          "type": "boolean",
          "default": true,
          "description": "Auto-commit after each passing story."
        },
        "driftCheck": {
          "type": "boolean",
          "default": false,
          "description": "Run convention drift detection before pipeline execution. Blocks trigger if error-severity violations found."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
