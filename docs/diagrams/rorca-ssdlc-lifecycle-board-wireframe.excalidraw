    {
      "id": "invariants_box", "type": "rectangle", "x": 1790, "y": 1670, "width": 820, "height": 150,
      "strokeColor": "#047857", "backgroundColor": "#a7f3d0", "fillStyle": "solid", "strokeWidth": 2,
      "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400067,
      "version": 1, "versionNonce": 400068, "isDeleted": false, "groupIds": [], "boundElements": null,
