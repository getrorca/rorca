    {
      "id": "interaction_text_8", "type": "text", "x": 1855, "y": 1039, "width": 735, "height": 96,
      "text": "Retry US-006\nOpens a governed preview: exact story/dependency scope, copied/skipped work, agent/model,\nenvironment, branch, validations and no-auto-merge policy. Approval queues the retry.",
      "originalText": "Retry US-006\nOpens a governed preview: exact story/dependency scope, copied/skipped work, agent/model,\nenvironment, branch, validations and no-auto-merge policy. Approval queues the retry.",
