    {
      "id": "interaction_text_5", "type": "text", "x": 1855, "y": 700, "width": 735, "height": 82,
      "text": "Phase cell\nOpens the 420–520 px detail drawer. Selection is specId + phaseId; the board remains visible.\nThe drawer explains required work, evidence, blockers and the next safe action.",
      "originalText": "Phase cell\nOpens the 420–520 px detail drawer. Selection is specId + phaseId; the board remains visible.\nThe drawer explains required work, evidence, blockers and the next safe action.",
