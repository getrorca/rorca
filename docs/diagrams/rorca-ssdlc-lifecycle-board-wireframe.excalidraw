    {
      "id": "interaction_text_7", "type": "text", "x": 1855, "y": 926, "width": 735, "height": 82,
      "text": "Gate or evidence row\nOpens Evidence Inspector with source, timestamp, immutable commit/SHA, check identity,\nredaction status and raw artifact reference. Agent claims alone never pass a gate.",
