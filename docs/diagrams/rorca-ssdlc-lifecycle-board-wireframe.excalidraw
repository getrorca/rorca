    {
      "id": "interaction_text_4", "type": "text", "x": 1855, "y": 589, "width": 735, "height": 80,
      "text": "Spec name\nOpens Spec Review directly on its Lifecycle sub-tab: phase timeline, requirement traceability,\nstory mapping, mapping history, readiness and version diffs.",
