    {
      "id": "retry_modal_text", "type": "text", "x": 1815, "y": 1317, "width": 770, "height": 250,
      "text": "RETRY PREVIEW · approval required\n\nScope          US-006 only · prior passed stories copied/skipped\nReason         tenant-isolation integration failure\nEnvironment    local-user · runner heartbeat must be fresh\nAgent/model    Pi · selected approved model\nGit            existing owned branch + isolated worktree\nValidation     focused test → broad regression → GitReins\nPublication    update existing draft PR · auto-merge=false\n\n[ Cancel ]                                  [ Approve exact retry ]",
      "originalText": "RETRY PREVIEW · approval required\n\nScope          US-006 only · prior passed stories copied/skipped\nReason         tenant-isolation integration failure\nEnvironment    local-user · runner heartbeat must be fresh\nAgent/model    Pi · selected approved model\nGit            existing owned branch + isolated worktree\nValidation     focused test → broad regression → GitReins\nPublication    update existing draft PR · auto-merge=false\n\n[ Cancel ]                                  [ Approve exact retry ]",
      "fontSize": 14, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "lineHeight": 1.35,
      "strokeColor": "#22c55e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1,
      "strokeStyle": "solid", "roughness": 0, "opacity": 100, "angle": 0, "seed": 400063,
