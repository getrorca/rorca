      "text": "Lifecycle invariants enforced behind the UI", "originalText": "Lifecycle invariants enforced behind the UI",
      "fontSize": 20, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top", "lineHeight": 1.25,
