    {
      "type": "text", "id": "skills_hierarchy_title",
      "x": 80, "y": 1408, "width": 200, "height": 18,
      "text": "Signal Strength (strongest → weakest):",
      "originalText": "Signal Strength (strongest → weakest):",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#9a3412", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
      "roughness": 0, "opacity": 100, "angle": 0,
      "seed": 7044, "version": 1, "versionNonce": 7045,
      "isDeleted": false, "groupIds": [], "boundElements": null,
      "link": null, "locked": false, "containerId": null, "lineHeight": 1.25
    },
    {
      "type": "text", "id": "skills_hierarchy_text",
      "x": 80, "y": 1430, "width": 950, "height": 150,
      "text": "MEMORY.md  (strongest — project-specific history, past bugs bias skill suggestions toward preventive skills)\n→  AGENTS.md  (zone governance — which area of codebase this story touches)\n→  Story text  (explicit tech mentions in the story description)\n→  Domain L2  (e.g. SaaS domain signals React, Prisma, Stripe patterns)\n→  Stack detection  (weakest — codebase tech scan via echolocation)",
      "originalText": "MEMORY.md  (strongest — project-specific history, past bugs bias skill suggestions toward preventive skills)\n→  AGENTS.md  (zone governance — which area of codebase this story touches)\n→  Story text  (explicit tech mentions in the story description)\n→  Domain L2  (e.g. SaaS domain signals React, Prisma, Stripe patterns)\n→  Stack detection  (weakest — codebase tech scan via echolocation)",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
