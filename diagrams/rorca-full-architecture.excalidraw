    {
      "type": "text", "id": "sec11_sub",
      "x": 70, "y": 1797, "width": 1960, "height": 18,
      "text": "Packs = 'frameworks for AI development' — encode project structure, patterns, and standards (L0 priority, overridable by L1-L5)",
      "originalText": "Packs = 'frameworks for AI development' — encode project structure, patterns, and standards (L0 priority, overridable by L1-L5)",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#64748b", "backgroundColor": "transparent",
