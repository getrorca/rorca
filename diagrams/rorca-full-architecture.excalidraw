    {
      "type": "text", "id": "skills_llm_t",
      "x": 100, "y": 1246, "width": 910, "height": 59,
      "text": "LLM Skill Matching   1 LLM call per spec (piggybacks on spec generation — zero extra cost)\nReceives: skill catalog (names+descriptions) + AGENTS.md + MEMORY.md + story text\nOutputs: suggestedSkills per story with relevance score 1-10 + reason field",
      "originalText": "LLM Skill Matching   1 LLM call per spec (piggybacks on spec generation — zero extra cost)\nReceives: skill catalog (names+descriptions) + AGENTS.md + MEMORY.md + story text\nOutputs: suggestedSkills per story with relevance score 1-10 + reason field",
      "fontSize": 12, "fontFamily": 3, "textAlign": "left", "verticalAlign": "top",
      "strokeColor": "#4c1d95", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid",
