# ── Stage 1: Build backend ──
FROM node:20-alpine AS build

WORKDIR /app/backend

# Install dependencies (cache layer)
COPY backend/package.json backend/package-lock.json* ./
RUN npm ci

# Copy source and compile TypeScript
COPY backend/tsconfig.json ./
COPY backend/src/ src/
RUN npx tsc

# ── Stage 2: Production runtime ──
FROM node:20-alpine

WORKDIR /app

# Install production dependencies only
COPY backend/package.json backend/package-lock.json* ./
RUN npm ci --omit=dev

# Copy compiled JS from build stage
COPY --from=build /app/backend/dist/ dist/

# Copy PostgreSQL migration files (needed at runtime by db/pg-index.ts)
COPY backend/src/db/pg-migrations/ dist/db/pg-migrations/

ENV DATABASE_URL=postgres://rorca:rorca@db:5432/rorca
ENV NODE_ENV=production
ENV PORT=3030

EXPOSE 3030

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:3030/api/health || exit 1

CMD ["node", "dist/server.js"]
