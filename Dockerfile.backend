# ── Stage 1: Build backend ──
FROM node:20-alpine AS build

# better-sqlite3 needs build tools for native compilation
RUN apk add --no-cache python3 make g++

WORKDIR /app/backend

# Install dependencies (cache layer)
COPY backend/package.json backend/package-lock.json* ./
RUN npm ci

# Copy source and compile TypeScript
COPY backend/tsconfig.json ./
COPY backend/src/ src/
RUN npx tsc

# ── Stage 2: Production runtime ──
FROM node:20-alpine

# better-sqlite3 native addon needs libstdc++
RUN apk add --no-cache libstdc++

WORKDIR /app

# Install production dependencies only
COPY backend/package.json backend/package-lock.json* ./
RUN apk add --no-cache python3 make g++ \
  && npm ci --omit=dev \
  && apk del python3 make g++

# Copy compiled JS from build stage
COPY --from=build /app/backend/dist/ dist/

# Copy SQL migration files (needed at runtime by db/index.ts)
COPY backend/src/db/migrations/ dist/db/migrations/

# Data directory for SQLite
RUN mkdir -p /data
ENV DB_PATH=/data/rorcha.db
ENV NODE_ENV=production
ENV PORT=3030

EXPOSE 3030

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:3030/api/health || exit 1

CMD ["node", "dist/server.js"]
